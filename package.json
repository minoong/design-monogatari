{
  "name": "design-monogatari",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css,mjs,js}\"",
    "//#format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css,mjs,js}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "verify": "turbo run //#format:check //#registry:check //#components:check //#copy:check lint check-types test build",
    "harness:trace": "node .claude/hooks/export-trace.mjs",
    "components:check": "node scripts/check-components.mjs",
    "copy:check": "node scripts/check-copy-tone.mjs",
    "component:new": "node scripts/scaffold-component.mjs",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:check": "node scripts/sync-registry.mjs --check",
    "registry:consumer-test": "node scripts/test-registry-consumer.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.21.4",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
