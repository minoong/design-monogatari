{
  "name": "design-monogatari",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs,js}\"",
    "check-types": "turbo run check-types",
    "verify": "pnpm format:check && turbo run lint check-types build"
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
