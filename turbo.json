{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "description": "Build applications and compiled packages for production",
      "dependsOn": ["^build", "check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "storybook-static/**"]
    },
    "lint": {
      "description": "Run ESLint in each package",
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs"]
    },
    "test": {
      "description": "Run unit tests (vitest) for pure TypeScript models",
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*"],
      "outputs": []
    },
    "topo": {
      "description": "Transit node for parallel type-checking with correct cache invalidation",
      "dependsOn": ["^topo"]
    },
    "check-types": {
      "description": "Run TypeScript type checking without emitting files",
      "dependsOn": ["topo"]
    },
    "dev": {
      "description": "Start long-running development servers",
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "description": "Start Storybook for @repo/ui",
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "description": "Build static Storybook for @repo/ui",
      "outputs": ["storybook-static/**"]
    },
    "//#registry:check": {
      "description": "Fail when registry/ copies or registry.json theme drift from packages/ui",
      "inputs": ["registry.json", "registry/**", "packages/ui/src/**", "scripts/sync-registry.mjs"],
      "outputs": []
    },
    "//#components:check": {
      "description": "Fail when a public @repo/ui component lacks a story, docs page, example, registry item, or DESIGN.md entry",
      "inputs": [
        "packages/ui/src/**",
        "packages/ui/components.config.json",
        "apps/docs/content/docs/components/**",
        "apps/docs/src/_examples/**",
        "registry.json",
        "registry/**",
        "DESIGN.md",
        "scripts/check-components.mjs"
      ],
      "outputs": []
    },
    "//#format:check": {
      "description": "Check Prettier formatting for the whole repository",
      "inputs": ["$TURBO_DEFAULT$", "**/*.{ts,tsx,md,mdx,json,css,mjs,js}", "!pnpm-lock.yaml"],
      "outputs": []
    }
  }
}
