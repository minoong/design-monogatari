{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-design.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/ui-verify.mjs afterFileEdit"
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/ui-verify.mjs afterShellExecution"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node .cursor/hooks/ui-verify.mjs afterMCPExecution"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/ui-verify.mjs stop",
        "loop_limit": 2
      }
    ]
  }
}
