          "color-blue-700": "#0055aa",
          "color-blue-800": "#004488",
          "color-blue-900": "#003366"
        },
        "light": {
          "background": "#ffffff",
          "foreground": "#1d1d1f",
          "muted": "#f5f5f7",
          "muted-foreground": "#6e6e73",
          "muted-strong": "#d2d2d7",
          "border": "#d2d2d7",
          "primary": "#0066cc",
          "primary-hover": "#0071e3",
          "primary-foreground": "#ffffff",
          "primary-on-dark": "#2997ff",
          "secondary-hover": "#f5f5f7",
          "ring": "#0071e3",
          "overlay": "color-mix(in srgb, #1d1d1f 48%, transparent)",
