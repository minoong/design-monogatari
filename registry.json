    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Design Monogatari theme",
      "description": "Shared @theme color tokens for design-monogatari components.",
      "cssVars": {
        "theme": {
          "text-title": "1.75rem",
          "text-title--line-height": "1.375",
          "text-body": "1.0625rem",
          "text-body--line-height": "1.625",
          "text-caption": "0.875rem",
          "text-caption--line-height": "1.5",
          "font-sans": "'Won Sign', var(--font-geist-sans, ui-sans-serif), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "font-mono": "var(--font-geist-mono, ui-monospace), 'SFMono-Regular', menlo, monaco, consolas, monospace",
          "radius-md": "11px",
          "radius-lg": "18px",
          "radius-pill": "9999px",
          "ease-out-expo": "cubic-bezier(0.22, 1, 0.36, 1)",
          "animate-button-loader-dot": "button-loader-dot 0.9s ease-in-out infinite",
          "animate-select-pop": "select-pop 0.32s var(--ease-out-expo) both",
          "animate-select-out": "select-out 0.2s cubic-bezier(0.4, 0, 0.8, 0.4) both",
          "animate-accordion-down": "accordion-down 0.28s var(--ease-out-expo) backwards",
          "animate-accordion-up": "accordion-up 0.2s var(--ease-out-expo) both"
        },
        "light": {
          "neutral-50": "#ffffff",
          "neutral-100": "#f5f5f7",
          "neutral-200": "#e3e3e7",
          "neutral-300": "#d2d2d7",
          "neutral-400": "#a1a1a6",
          "neutral-500": "#6e6e73",
          "neutral-600": "#58585c",
          "neutral-700": "#424245",
          "neutral-800": "#2f2f32",
          "neutral-900": "#1d1d1f",
          "neutral-950": "#000000",
          "blue-50": "#f2f9ff",
          "blue-100": "#e1f1ff",
          "blue-200": "#c3e2ff",
          "blue-300": "#74bbff",
          "blue-400": "#2997ff",
          "blue-500": "#0071e3",
          "blue-600": "#0066cc",
          "blue-700": "#0055aa",
          "blue-800": "#004488",
          "blue-900": "#003366",
          "background": "#ffffff",
          "foreground": "#1d1d1f",
          "muted": "#f5f5f7",
          "muted-foreground": "#6e6e73",
          "border": "#d2d2d7",
          "primary": "#0066cc",
          "primary-hover": "#0071e3",
          "primary-foreground": "#ffffff",
          "primary-on-dark": "#2997ff",
          "secondary-hover": "#f5f5f7",
          "ring": "#0071e3",
          "overlay": "rgb(29 29 31 / 48%)",
          "card": "#ffffff",
          "dimmer": "#000000",
          "destructive": "#c41e3a",
          "destructive-foreground": "#ffffff",
          "muted-strong": "#d2d2d7"
        },
        "dark": {
          "background": "#000000",
          "foreground": "#eeeef0",
          "muted": "#121315",
          "muted-foreground": "#b2b3bd",
          "border": "#393a3f",
          "primary": "#003cff",
          "primary-hover": "#0022ed",
          "primary-foreground": "#ffffff",
          "primary-on-dark": "#8ab5ff",
          "secondary-hover": "#1f1f22",
          "ring": "#3b6ee6",
          "overlay": "rgb(0 0 0 / 64%)",
          "card": "#121315",
          "dimmer": "#000000",
          "destructive": "#ff6369",
          "destructive-foreground": "#000000",
          "muted-strong": "#393a3f"
        }
      },
      "css": {
        "@keyframes accordion-down": {
          "from": {
            "height": "0",
            "opacity": "0"
          },
          "to": {
            "height": "var(--radix-accordion-content-height)",
            "opacity": "1"
          }
        },
        "@keyframes accordion-up": {
          "from": {
            "height": "var(--radix-accordion-content-height)",
            "opacity": "1"
          },
          "to": {
            "height": "0",
            "opacity": "0"
          }
        },
        "@keyframes select-out": {
          "0%": {
            "opacity": "1",
            "transform": "scale(1)"
          },
          "60%": {
            "opacity": "1"
          },
          "100%": {
            "opacity": "0",
            "transform": "scale(0.6)"
          }
        },
        "@keyframes select-pop": {
          "0%": {
            "transform": "scale(0.6)"
          },
          "60%": {
            "transform": "scale(1.12)"
          },
          "100%": {
            "transform": "scale(1)"
          }
        },
        "@keyframes button-loader-dot": {
          "0%, 80%, 100%": {
            "opacity": "0.24"
          },
          "40%": {
            "opacity": "1"
          }
        }
      }
    },
