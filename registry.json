{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "design-monogatari",
  "homepage": "https://github.com/minoong/design-monogatari",
  "items": [
    {
      "name": "cn",
      "type": "registry:lib",
      "title": "cn utility",
      "description": "Merge Tailwind classes with clsx and tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "packages/ui/src/lib/cn.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
