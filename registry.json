        "dark": {
          "background": "#000000",
          "foreground": "#eeeef0",
          "muted": "#121315",
          "muted-foreground": "#b2b3bd",
          "muted-strong": "#393a3f",
          "border": "#393a3f",
          "primary": "#003cff",
          "primary-hover": "#0022ed",
          "primary-foreground": "#ffffff",
          "primary-on-dark": "#8ab5ff",
          "secondary-hover": "#1f1f22",
