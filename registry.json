          "radius-md": "11px",
          "radius-lg": "18px",
          "radius-pill": "9999px",
          "text-title": "1.75rem",
          "text-body": "1.0625rem",
          "text-caption": "0.875rem",
          "color-neutral-50": "#ffffff",
          "color-neutral-100": "#f5f5f7",
          "color-neutral-200": "#e3e3e7",
          "color-neutral-300": "#d2d2d7",
          "color-neutral-400": "#a1a1a6",
          "color-neutral-500": "#6e6e73",
          "color-neutral-600": "#58585c",
          "color-neutral-700": "#424245",
          "color-neutral-800": "#2f2f32",
