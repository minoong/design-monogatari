{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "design-monogatari",
  "homepage": "https://github.com/minoong/design-monogatari",
  "items": [
    {
      "name": "cn",
      "type": "registry:lib",
      "title": "cn utility",
      "description": "Merge Tailwind classes with clsx and tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "packages/ui/src/lib/cn.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "motion",
      "type": "registry:lib",
      "title": "Motion tokens",
      "description": "Duration, easing, spring and stagger tokens shared by animated components.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "packages/ui/src/lib/motion.ts",
          "type": "registry:lib",
          "target": "@lib/motion.ts"
        }
      ]
    },
    {
      "name": "check-phase",
      "type": "registry:lib",
      "title": "Check phase hook",
      "description": "Tells a checkbox or radio whether it was just selected or just cleared, so enter and exit motion skips the first paint.",
      "files": [
        {
          "path": "packages/ui/src/lib/check-phase.ts",
          "type": "registry:lib",
          "target": "@lib/check-phase.ts"
        }
      ]
    },
    {
